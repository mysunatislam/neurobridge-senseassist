rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public, non-clinical metadata used to prove the live Firestore integration.
    match /public_judge_manifest/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Patient, session, and application data are never exposed through Firestore.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
